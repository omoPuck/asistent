$ sh /home/asistent/code/asistent/scripts/run-service.sh unit-file
# MVP-8 常驻服务（用户级 unit；设备已 enable-linger，不需要 sudo）
#
# 安装（设备上执行）：
#   mkdir -p ~/.config/systemd/user
#   /home/asistent/code/asistent/scripts/run-service.sh unit-file > ~/.config/systemd/user/asistent.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now asistent.service
#   systemctl --user status asistent.service
#
# 崩溃自动重启（Restart=always）。**重启不会重发**：新一轮先把
# IN_FLIGHT 的外部动作降级为 UNKNOWN 并从存储重算该做什么，
# 已提交给通道的动作绝不会因为进程重启而再发一次（见 docs/mvp/mvp-8.md §崩溃自愈）。
#
# 凭据纪律：本 unit 里**没有**任何口令/授权码/令牌；服务自己从
# /home/asistent/asistent-var/config/console-token（600）与
# /home/asistent/asistent-var/bin/set-mail-authcode.sh（700）之外的文件读取，内容不进日志。
[Unit]
Description=asistent 24h 常驻服务（邮件→理解→草稿→审批→外发→归档）
Documentation=file:///home/asistent/code/asistent/docs/mvp/mvp-8.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/asistent/code/asistent
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONPATH=/home/asistent/code/asistent
Environment=ASISTENT_VAR=/home/asistent/asistent-var
Environment=ASISTENT_STORE=sqlite
ExecStart=/usr/bin/python3 -X utf8 -m asistent.service --loop --console --max-rounds 0 --config /home/asistent/asistent-var/config/service.json
StandardOutput=append:/home/asistent/asistent-var/logs/service.log
StandardError=append:/home/asistent/asistent-var/logs/service.log
Restart=always
RestartSec=5
# 不因为"短时间重启太多次"而放弃：宁可慢一点重启，也不要静默死掉
StartLimitIntervalSec=0
KillSignal=SIGTERM
TimeoutStopSec=90
# 运行数据只在 /home/asistent/asistent-var 里：unit 不给额外写权限
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target

